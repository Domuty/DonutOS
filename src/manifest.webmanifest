{
  "name": "DonutOS",
  "short_name": "DonutOS",
  "description": "A desktop operating system that runs in your browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["window-controls-overlay", "fullscreen", "standalone"],
  "background_color": "#000000",
  "theme_color": "#14101a",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "assets/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/brand/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
