{
  "name": "donutos",
  "productName": "DonutOS",
  "version": "1.0.0",
  "description": "DonutOS — a desktop operating system environment for the web and the desktop.",
  "main": "electron/main.js",
  "author": "DonutOS contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:windowed": "electron . --windowed",
    "serve": "node scripts/serve.js",
    "build:catalog": "node scripts/build-catalog.js",
    "build:precache": "node scripts/build-catalog.js && node scripts/build-precache.js",
    "vendor": "node scripts/vendor.js",
    "test": "npm run test:node && npm run test:desktop",
    "test:node": "node --test tests/node/*.test.js",
    "test:desktop": "electron . --tests",
    "dist": "npm run build:precache && electron-builder",
    "dist:win": "npm run build:precache && electron-builder --win --x64 --arm64",
    "dist:mac": "npm run build:precache && electron-builder --mac --universal",
    "dist:linux": "npm run build:precache && electron-builder --linux --x64 --arm64",
    "pack-dapp": "node scripts/pack-dapp.js",
    "release": "npm run build:precache && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "jszip": "3.10.1"
  },
  "build": {
    "appId": "app.donutos.desktop",
    "productName": "DonutOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!src/tests/**/*",
      "!src/store/apps/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Domuty",
        "repo": "DonutOS",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "DonutOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DonutOS",
      "artifactName": "DonutOS-Setup-${version}.${ext}",
      "uninstallDisplayName": "DonutOS",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "DonutOS-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "A desktop operating system environment",
      "maintainer": "DonutOS contributors <noreply@donutos.app>",
      "artifactName": "DonutOS-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "dmg": {
      "title": "DonutOS ${version}",
      "artifactName": "DonutOS-${version}-mac.${ext}"
    },
    "deb": {
      "artifactName": "DonutOS-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Domuty/DonutOS.git"
  },
  "homepage": "https://github.com/Domuty/DonutOS",
  "desktopName": "donutos.desktop"
}
